/-
NPT.Cert.EP3D4.KBound — the crude word-value bound of the kernel identity route at d = 4, in the form of the
hypothesis `hB` of `KAssembly.hsumK_f<f>`, stated with `eqLocF cert` (`= eqTK eqTabsK cert`, `KEqOK.eqTK_eqLocF`):
`wordBound_f<f>`: every word value of family `f` is at most `KB = 2^6822` (sum-form bound `crudeBS`, `KRBoundSplit`;
the three families in one kernel evaluation, so the block scan `zqBmax` runs once). Generated by
an internal script
-/
import NPT.Cert.EP3D4.IdDefs
import NPT.Cert.Ident.KRBoundSplit
set_option maxRecDepth 100000

open NPT.Cert.Ident NPT.Cert.Sem

namespace NPT.Cert.EP3D4

/-- The word-value bound, for every family. -/
def KB : ℕ := 2 ^ 6822

/-- The sum-form crude bounds of the three families (one kernel evaluation). -/
theorem crudeBS_le_KB : crudeBS cert zmul 0 gs0 zsT zaT ≤ KB ∧ crudeBS cert zmul 1 gs1 zsT zaT ≤ KB ∧
    crudeBS cert zmul 2 gs2 zsT zaT ≤ KB := by decide +kernel

theorem wordBound_f0 : ∀ w0 w1 w2 w3, w0 < 24 → w1 < 24 → w2 < 24 → w3 < 24 →
    |partsF (famParts cert zmul 0 gs0 zsT zaT (eqLocF cert)) w0 w1 w2 w3| ≤ KB := fun w0 w1 w2 w3 h0 h1 h2 h3 =>
  le_trans (partsF_le_crudeBS_eqLocF cert zmul 0 gs0 zsT zaT w0 w1 w2 w3 h0 h1 h2 h3)
    (by exact_mod_cast crudeBS_le_KB.1)

theorem wordBound_f1 : ∀ w0 w1 w2 w3, w0 < 24 → w1 < 24 → w2 < 24 → w3 < 24 →
    |partsF (famParts cert zmul 1 gs1 zsT zaT (eqLocF cert)) w0 w1 w2 w3| ≤ KB := fun w0 w1 w2 w3 h0 h1 h2 h3 =>
  le_trans (partsF_le_crudeBS_eqLocF cert zmul 1 gs1 zsT zaT w0 w1 w2 w3 h0 h1 h2 h3)
    (by exact_mod_cast crudeBS_le_KB.2.1)

theorem wordBound_f2 : ∀ w0 w1 w2 w3, w0 < 24 → w1 < 24 → w2 < 24 → w3 < 24 →
    |partsF (famParts cert zmul 2 gs2 zsT zaT (eqLocF cert)) w0 w1 w2 w3| ≤ KB := fun w0 w1 w2 w3 h0 h1 h2 h3 =>
  le_trans (partsF_le_crudeBS_eqLocF cert zmul 2 gs2 zsT zaT w0 w1 w2 w3 h0 h1 h2 h3)
    (by exact_mod_cast crudeBS_le_KB.2.2)

end NPT.Cert.EP3D4
