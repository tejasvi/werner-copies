/-- Denominators of the generalized inverses. -/
def hDen (n : ℕ) : ℕ := if n = 3 then 8640 else if n = 2 then 2880 else 1

/-- Integer generalized inverse (`H = hInt / hDen`), zero for n ∉ {2, 3}. -/
def hInt (n : ℕ) (p q : Fin 24) : ℤ :=
  if n = 3 then (hRows3.getD p.val []).getD q.val 0 else if n = 2 then (hRows2.getD p.val []).getD q.val 0 else 0

/-- `Σ_q Σ_r gram p q · hInt q r · gram r s` over lists (kernel-cheap). -/
def ghg (n : ℕ) (p s : Fin 24) : ℤ :=
  ((List.finRange 24).map fun q => gram n p q * ((List.finRange 24).map fun r => hInt n q r * gram n r s).sum).sum

/-- **`G H G = G`**: `Σ_q Σ_r gram p q · hInt q r · gram r s = hDen · gram p s` (n = 2, 3). -/
def ghgOK (n : ℕ) : Bool :=
  (List.finRange 24).all fun p => (List.finRange 24).all fun s => ghg n p s == (hDen n : ℤ) * gram n p s

theorem ghg_ok3 : ghgOK 3 = true := by decide +kernel
theorem ghg_ok2 : ghgOK 2 = true := by decide +kernel

/-- Row-sum norm of `hInt` (numerator of `‖H‖∞`). -/
def hRowMax (n : ℕ) : ℕ := ((List.finRange 24).map fun p => ((List.finRange 24).map fun q => (hInt n p q).natAbs).sum).foldr max 0

theorem hRowMax3 : hRowMax 3 = 786 := by decide +kernel
theorem hRowMax2 : hRowMax 2 = 496 := by decide +kernel

end NPT.K4
