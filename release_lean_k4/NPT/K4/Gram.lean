/-
NPT.K4.Gram — the Gram matrices of the permutation operators on four replicas and a generalized inverse of each:
`gram n p q = tr(V_pᴴ V_q) = trF n (p⁻¹ q)` on `(ℂ^n)^{⊗4}`, and integer data `hInt n`, `hDen n` such that
`H = hInt / hDen` satisfies `gram · H · gram = gram` (kernel-checked, `ghg_ok`) for n = 2 and n = 3.  `H` is the
Moore–Penrose inverse (computed in exact rational arithmetic; only `G H G = G` is used).  Its row-sum norm is
`131/1440` (n = 3, rank 23) and `31/180` (n = 2, rank 14), as in the K4 verifier.
-/
import NPT.Cert.Ident.ObjEqF
import NPT.Cert.Lit

open BigOperators Finset NPT.Brauer NPT.Cert NPT.Cert.Sem NPT.Cert.Ident NPT.Cert.Lit

namespace NPT.K4

/-- `tr(V_pᴴ V_q)` on `(ℂ^n)^{⊗4}`, as an integer: `V_pᴴ = V_{p⁻¹}` and `V_{p⁻¹} V_q = V_{p⁻¹ q}`. -/
def gram (n : ℕ) (p q : Fin 24) : ℤ := trF n (mulIdx (pinvIdx p) q)

