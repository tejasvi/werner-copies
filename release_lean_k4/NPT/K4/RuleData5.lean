/-- All 25 rules: the 13 verified rules, then the 12 additional ones. -/
def ruleTab5 : List (List (List ℕ)) := ruleTab ++ newRuleTab

/-- Rule `i` of `ruleTab5` as a record. -/
def rule5 (i : ℕ) : RuleRec := recOf (ruleTab5.getD i [])

theorem rules5_ok : ∀ i : Fin 25, (rule5 i.val).OK := by decide +kernel

/-- Cut of every rule of `ruleTab5` (each lies in `cutsUsed`). -/
theorem rules5_cut : ∀ i : Fin 25, (rule5 i.val).cut ∈ cutsUsed := by decide +kernel

end NPT.K4

